# --- База данных ---
DATABASE_URL="postgresql://user:password@localhost:5432/smartcity"

# --- HTTP-сервер ---
PORT=3000
CORS_ORIGIN=* # Откуда разрешены запросы к API
NODE_ENV=development # Режим prod / development

# --- Бот MAX ---
MAX_BOT_TOKEN= # токен бота

# --- Управляющая компания ---
UK_ACCESS_CODE=change-me # Код, по которому сотрудник УК получает права: команда /uk_login <код>
UK_ADMIN_IDS=93344998 # MAX ID сотрудников УК — получают права автоматически

# --- Мини-приложение ---
DEV_AUTH_BYPASS=true # true - для dev разработки, сервер верит id пользователя из initDataUnsafe; false — только подписанный initData
INIT_DATA_MAX_AGE_SEC=86400 # Максимальный возраст initData в секундах
 
# --- Правила заявок ---
VOTE_PERCENT_DEFAULT=20 # Процент подписей, необходимый для передачи заявки в УК (значение по умолчанию для новых домов)
DEFAULT_DEADLINE_DAYS=14 # Срок сбора подписей по умолчанию, дней
EXPIRE_CHECK_INTERVAL_SEC=300 # Как часто проверять просроченные заявки, секунд
NOTIFY_POLL_INTERVAL_SEC=3

# --- Карта и проверка квартиры (OpenStreetMap) ---
# Overpass API: дом по точке на карте, число квартир и подъезды. Публичные серверы бывают перегружены (429/504),
# поэтому адреса перебираются по очереди (через запятую); если все недоступны — дом берётся из Nominatim без подъездов
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Почта для передачи заявок в организации (если не задано — отправка имитируется и пишется в лог) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
