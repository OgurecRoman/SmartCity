# --- База данных (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/smartcity"

PORT=3000
# Откуда разрешены запросы к API (домен мини-приложения). * — для разработки
CORS_ORIGIN=*

# --- Бот MAX ---
MAX_BOT_TOKEN=
BOT_ENABLED=true
# polling — для локальной разработки (публичный адрес не нужен), webhook — для прода (нужен HTTPS)
BOT_MODE=polling
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/bot/webhook
WEBHOOK_SECRET=
# Публичное имя бота для ссылок вида https://max.ru/<имя>?start=... Если пусто — берётся из профиля бота
BOT_USERNAME=

# --- Управляющая компания ---
# Код, по которому сотрудник УК получает права: команда /uk_login <код>
UK_ACCESS_CODE=change-me
# MAX ID сотрудников УК через запятую — получают права автоматически
UK_ADMIN_IDS=

# --- Мини-приложение (отдаётся сервером по /app/, в боте — кнопка-ссылка https://max.ru/<бот>?startapp) ---
# true — простой режим: сервер верит id пользователя, который мини-приложение берёт из SDK MAX (initDataUnsafe),
# без проверки подписи; в браузере можно открыть /app/?dev=<MAX id>. false — только подписанный initData
DEV_AUTH_BYPASS=true
# Максимальный возраст initData в секундах
INIT_DATA_MAX_AGE_SEC=86400

# --- Правила заявок ---
# Доля жителей дома (в %), чьи подписи нужны для передачи заявки в УК (значение по умолчанию для новых домов)
VOTE_PERCENT_DEFAULT=20
# Срок сбора подписей по умолчанию, дней
DEFAULT_DEADLINE_DAYS=14
# Как часто проверять просроченные заявки, секунд
EXPIRE_CHECK_INTERVAL_SEC=300

# --- Карта и проверка квартиры (OpenStreetMap, ключ не нужен) ---
# Overpass API: дом по точке на карте, число квартир и подъезды. Публичные серверы бывают перегружены (429/504),
# поэтому адреса перебираются по очереди (через запятую); если все недоступны — дом берётся из Nominatim без подъездов
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Nominatim: поиск адреса по строке и запасное обратное геокодирование
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Почта для передачи заявок в организации (если не задано — отправка имитируется и пишется в лог) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
