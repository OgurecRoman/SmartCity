generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RESIDENT
  UK_EMPLOYEE
  CHAIRMAN
}

enum ResidentType {
  OWNER
  TENANT
}

enum RequestCategory {
  NOISE
  ELEVATOR
  PLUMBING
  ELECTRICITY
  REPAIR
  CLEANING
  SECURITY
  OTHER
}

enum RequestPriority {
  NORMAL
  EMERGENCY
}

enum RequestStatus {
  VOTING
  SUBMITTED
  IN_PROGRESS
  DELEGATED
  RESOLVED
  REJECTED
  EXPIRED
}

model ManagementCompany {
  id            Int                       @id @default(autoincrement())
  name          String
  phone         String
  email         String?
  address       String?
  workingHours  String?
  createdAt     DateTime                  @default(now())
  houses        House[]
  employees     User[]
  organizations ResponsibleOrganization[]
}

model House {
  id          Int       @id @default(autoincrement())
  address     String
  lat         Float?
  lng         Float?
  apartmentsCount Int?
  entrances   Json?
  externalId  String?   @unique
  dataSource  String?
  votePercent Int       @default(20)
  chatId      BigInt?   @unique
  chatTitle   String?
  companyId   Int
  company     ManagementCompany @relation(fields: [companyId], references: [id])
  residents   User[]
  requests    Request[]
  announcements Announcement[]
  news        News[]
  createdAt   DateTime  @default(now())
}

model User {
  id            Int           @id @default(autoincrement())
  maxUserId     BigInt        @unique
  role          UserRole      @default(RESIDENT)
  firstName     String
  lastName      String?
  username      String?
  houseId       Int?
  house         House?        @relation(fields: [houseId], references: [id])
  apartment     String?
  residentType  ResidentType?
  companyId     Int?
  company       ManagementCompany? @relation(fields: [companyId], references: [id])
  onboardedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  requests      Request[]
  votes         Vote[]
  statusChanges StatusHistory[]
  announcements Announcement[]
  news          News[]
}

model Request {
  id            Int             @id @default(autoincrement())
  houseId       Int
  house         House           @relation(fields: [houseId], references: [id])
  authorId      Int
  author        User            @relation(fields: [authorId], references: [id])
  title         String
  description   String
  category      RequestCategory
  priority      RequestPriority @default(NORMAL)
  status        RequestStatus   @default(VOTING)
  votesCount    Int             @default(0)
  votesRequired Int             @default(1)
  deadline      DateTime?
  submittedAt   DateTime?
  resolvedAt    DateTime?
  delegatedToId Int?
  delegatedTo   ResponsibleOrganization? @relation(fields: [delegatedToId], references: [id])
  delegatedAt   DateTime?
  chatMessageId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  votes         Vote[]
  statusHistory StatusHistory[]

  @@index([houseId, status])
  @@index([authorId])
}

model Vote {
  id        Int      @id @default(autoincrement())
  requestId Int
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([requestId, userId])
}

model StatusHistory {
  id          Int            @id @default(autoincrement())
  requestId   Int
  request     Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  oldStatus   RequestStatus?
  newStatus   RequestStatus
  comment     String?
  changedById Int?
  changedBy   User?          @relation(fields: [changedById], references: [id])
  changedAt   DateTime       @default(now())

  @@index([requestId])
}

model ResponsibleOrganization {
  id         Int               @id @default(autoincrement())
  companyId  Int
  company    ManagementCompany @relation(fields: [companyId], references: [id])
  name       String
  email      String?
  phone      String?
  categories RequestCategory[]
  requests   Request[]
}

model Announcement {
  id            Int      @id @default(autoincrement())
  houseId       Int
  house         House    @relation(fields: [houseId], references: [id])
  authorId      Int
  author        User     @relation(fields: [authorId], references: [id])
  title         String
  description   String
  chatMessageId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([houseId])
}

model News {
  id            Int      @id @default(autoincrement())
  houseId       Int
  house         House    @relation(fields: [houseId], references: [id])
  authorId      Int
  author        User     @relation(fields: [authorId], references: [id])
  title         String
  description   String
  contact       String
  chatMessageId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([houseId])
}

model BotSession {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
