generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Роль пользователя: житель или сотрудник управляющей компании
enum UserRole {
  RESIDENT
  UK_EMPLOYEE
}

/// Статус жителя в квартире
enum ResidentType {
  OWNER
  TENANT
}

/// Категория заявки
enum RequestCategory {
  NOISE
  ELEVATOR
  PLUMBING
  ELECTRICITY
  REPAIR
  CLEANING
  SECURITY
  OTHER
}

/// Приоритет: аварийные заявки минуют сбор подписей
enum RequestPriority {
  NORMAL
  EMERGENCY
}

/// Жизненный цикл заявки
enum RequestStatus {
  VOTING      // на сборе подписей
  SUBMITTED   // передана в УК
  IN_PROGRESS // решается
  DELEGATED   // передана в ответственную организацию
  RESOLVED    // сделано
  REJECTED    // отклонена
  EXPIRED     // срок сбора подписей истёк
}

model ManagementCompany {
  id            Int                       @id @default(autoincrement())
  name          String
  phone         String
  email         String?
  address       String?
  workingHours  String?
  createdAt     DateTime                  @default(now())
  houses        House[]
  employees     User[]
  organizations ResponsibleOrganization[]
}

model House {
  id          Int       @id @default(autoincrement())
  address     String
  /// Координаты дома для карты в мини-приложении
  lat         Float?
  lng         Float?
  /// Сколько квартир в доме (для проверки номера квартиры); null — неизвестно
  apartmentsCount Int?
  /// Подъезды с диапазонами квартир: [{ "number": "1", "from": 1, "to": 20 }]
  entrances   Json?
  /// Идентификатор здания во внешнем источнике, например osm:way/61424311
  externalId  String?   @unique
  /// Откуда взяты сведения о доме: osm (OpenStreetMap) или manual
  dataSource  String?
  /// Доля жителей дома (в процентах), чьи подписи нужны для передачи заявки в УК
  votePercent Int       @default(20)
  /// Идентификатор группового чата дома в MAX, куда бот шлёт уведомления
  chatId      BigInt?   @unique
  chatTitle   String?
  companyId   Int
  company     ManagementCompany @relation(fields: [companyId], references: [id])
  residents   User[]
  requests    Request[]
  createdAt   DateTime  @default(now())
}

model User {
  id            Int           @id @default(autoincrement())
  /// Идентификатор пользователя в MAX
  maxUserId     BigInt        @unique
  role          UserRole      @default(RESIDENT)
  firstName     String
  lastName      String?
  username      String?
  houseId       Int?
  house         House?        @relation(fields: [houseId], references: [id])
  apartment     String?
  residentType  ResidentType?
  companyId     Int?
  company       ManagementCompany? @relation(fields: [companyId], references: [id])
  /// Момент завершения регистрации (дом + квартира + статус)
  onboardedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  requests      Request[]
  votes         Vote[]
  statusChanges StatusHistory[]
}

model Request {
  id            Int             @id @default(autoincrement())
  houseId       Int
  house         House           @relation(fields: [houseId], references: [id])
  authorId      Int
  author        User            @relation(fields: [authorId], references: [id])
  title         String
  description   String
  category      RequestCategory
  priority      RequestPriority @default(NORMAL)
  status        RequestStatus   @default(VOTING)
  /// Сколько подписей уже собрано
  votesCount    Int             @default(0)
  /// Сколько подписей нужно (снимок на момент последнего пересчёта)
  votesRequired Int             @default(1)
  /// Срок сбора подписей
  deadline      DateTime?
  submittedAt   DateTime?
  resolvedAt    DateTime?
  delegatedToId Int?
  delegatedTo   ResponsibleOrganization? @relation(fields: [delegatedToId], references: [id])
  delegatedAt   DateTime?
  /// mid сообщения-уведомления в чате дома (для обновления счётчика)
  chatMessageId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  votes         Vote[]
  statusHistory StatusHistory[]

  @@index([houseId, status])
  @@index([authorId])
}

model Vote {
  id        Int      @id @default(autoincrement())
  requestId Int
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([requestId, userId])
}

model StatusHistory {
  id          Int            @id @default(autoincrement())
  requestId   Int
  request     Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  oldStatus   RequestStatus?
  newStatus   RequestStatus
  comment     String?
  changedById Int?
  changedBy   User?          @relation(fields: [changedById], references: [id])
  changedAt   DateTime       @default(now())

  @@index([requestId])
}

/// Организация, в которую УК передаёт заявку (лифтовая служба, водоканал и т.д.)
model ResponsibleOrganization {
  id         Int               @id @default(autoincrement())
  companyId  Int
  company    ManagementCompany @relation(fields: [companyId], references: [id])
  name       String
  email      String?
  phone      String?
  categories RequestCategory[]
  requests   Request[]
}

/// Сессии бота (пошаговые сценарии), чтобы переживать перезапуск
model BotSession {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
