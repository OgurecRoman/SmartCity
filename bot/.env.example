# --- Бот MAX ---
MAX_BOT_TOKEN= # токен бота
BOT_ENABLED=true
BOT_MODE=polling # polling для локальной разработки, webhook для прода
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/bot/webhook
WEBHOOK_SECRET=
BOT_WEBHOOK_PORT=3001 # порт, на котором процесс бота поднимает свой HTTP-сервер под вебхук
BOT_USERNAME= # публичное имя бота

# --- Бэкенд (server/) ---
BACKEND_API_URL=http://localhost:3000 # адрес API; бот ходит только по HTTP, к БД не подключается
BOT_API_TOKEN= # должен совпадать с BOT_API_TOKEN сервера (пусто — если на сервере тоже пусто)
NOTIFY_POLL_INTERVAL_SEC=3 # как часто бот забирает очередь уведомлений с бэкенда (секунды)
DEFAULT_DEADLINE_DAYS=14 # только для подсказки жителю о сроке сбора подписей; сам срок выставляет сервер
