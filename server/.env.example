# --- база данных ---
DATABASE_URL="postgresql://user:password@localhost:5432/smartcity"

# --- HTTP-сервер (апи и вебхук) ---
PORT=3000
# откуда разрешены запросы к апи
CORS_ORIGIN=*

# --- бот MAX ---
# токен выданный организаторами, без токена сервер запускается только как апи
MAX_BOT_TOKEN=
BOT_ENABLED=true
# polling для локальной разработки, webhook для прода
BOT_MODE=polling
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/bot/webhook
WEBHOOK_SECRET=
# публичное имя бота для ссылок вида https://max.ru/<имя бота>?start=...
BOT_USERNAME=

# --- ук (управляющая компания) ---
# код, по которому сотрудник ук получает права - команда /uk_login <код>
UK_ACCESS_CODE=change-me
# макс айди сотрудников ук через запятую, они получат права автоматически
UK_ADMIN_IDS=

# --- мини-приложение (отдаётся сервером по /app/, в боте встроен) ---
# true - простой режим авторизации, то есть сервер верит id пользователя, который мини-приложение берёт из SDK MAX,
# без проверки подписи, в браузере можно открыть /app/?dev=<MAX id>. для прода false - только подписанный initData для безопасности
DEV_AUTH_BYPASS=true
# максимальный возраст initData в секундах
INIT_DATA_MAX_AGE_SEC=86400

# --- правила заявок ---
# доля жителей дома, чьи подписи нужны для передачи заявки в ук
VOTE_PERCENT_DEFAULT=20
# срок сбора подписей по умолчанию (дни)
DEFAULT_DEADLINE_DAYS=14
# частота проверок просроченных заявок (секунды)
EXPIRE_CHECK_INTERVAL_SEC=300

# --- карта и проверка квартиры (OpenStreetMap, ключ не нужен) ---
# Overpass API: дом по точке на карте, число квартир и подъезды. публичные серверы бывают перегружены,
# поэтому адреса перебираются по очереди (через запятую)
# если все недоступны - дом берётся из Nominatim без подъездов
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Nominatim: поиск адреса по строке и запасное обратное геокодирование
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- почта для передачи заявок в организации (если не задано - отправка имитируется и пишется в лог) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
