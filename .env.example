# Скопируйте в .env в корне репозитория: cp .env.example .env

# --- Порт мини-приложения на хосте ---
HTTP_PORT=8080

# --- PostgreSQL ---
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=smartcity

# --- Публичный URL API для сборки клиента ---
# Оставьте пустым, если клиент ходит на тот же хост через nginx (/api, /uploads).
# Если API на другом домене — укажите полный URL, например https://api.example.com
VITE_API_URL=
VITE_YANDEX_MAPS_API_KEY=

# --- CORS ---
# На VPS с поддоменом:
CORS_ORIGIN=https://smartcity.visitly.ru

# --- Бот MAX (общий токен для server + bot) ---
MAX_BOT_TOKEN=
BOT_API_TOKEN=change-me-shared-secret
BOT_ENABLED=true
BOT_MODE=polling
BOT_USERNAME=
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/bot/webhook
WEBHOOK_SECRET=
BOT_WEBHOOK_PORT=3001

# --- УК ---
UK_ACCESS_CODE=change-me
UK_ADMIN_IDS=

# --- Прод: подпись initData обязательна ---
DEV_AUTH_BYPASS=false
INIT_DATA_MAX_AGE_SEC=86400

# --- Правила заявок ---
VOTE_PERCENT_DEFAULT=20
DEFAULT_DEADLINE_DAYS=14
EXPIRE_CHECK_INTERVAL_SEC=300
NOTIFY_POLL_INTERVAL_SEC=3

# --- Гео / SMTP (опционально) ---
YANDEX_GEO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
