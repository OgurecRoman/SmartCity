# --- Бот MAX ---
MAX_BOT_TOKEN= # токен бота
BOT_ENABLED=true
BOT_MODE=polling # polling для локальной разработки, webhook для прода
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/bot/webhook
WEBHOOK_SECRET=
BOT_WEBHOOK_PORT=3001 # порт, на котором процесс бота поднимает свой HTTP-сервер под вебхук
BOT_USERNAME= # публичное имя бота
NOTIFY_POLL_INTERVAL_SEC=3 # как часто бот проверяет NotificationOutbox и рассылает уведомления (секунды)

BACKEND_API_URL=http://localhost:3000